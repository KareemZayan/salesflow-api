# ---------- App ----------
# REQUIRED, no default: development | test | production. A missing or unsupported value stops the app
# at startup (a forgotten value must never silently mean "not production"). The Docker image sets
# production itself; the dev compose override sets development.
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
LOG_LEVEL=debug
# Comma-separated browser origins allowed to call the API. Empty blocks every other origin; with
# NODE_ENV=production an empty value logs a warning at startup.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true

# ---------- Database (PostgreSQL 16) ----------
POSTGRES_USER=salesflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=salesflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port published by the dev compose override (change if 5432 is taken locally).
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://salesflow:change_me@localhost:5432/salesflow?schema=public

# ---------- Database pool and timeouts (docs/decisions/0016-hardening.md) ----------
# Connections PER API PROCESS. Keep   instances_at_peak x DB_POOL_MAX  <=  max_connections - 10.
# PostgreSQL's default max_connections is 100, so: 1 instance -> up to 90, 3 -> 30, 9 -> 10.
# "Peak" includes the extra instance a rolling deploy starts and any separate worker process.
# 10 is the pg default and is NOT tuned to a measured load; revisit with a real p95 before production.
DB_POOL_MAX=10
# A request waits at most this long for a free connection, then gets 503 DATABASE_BUSY.
DB_POOL_ACQUIRE_TIMEOUT_MS=5000
# One statement, including a wait for a lock (enforced by PostgreSQL). Must be SMALLER than the
# transaction timeout: Prisma cannot interrupt a statement blocked on a lock, PostgreSQL can.
DB_STATEMENT_TIMEOUT_MS=8000
# A whole interactive transaction (enforced by Prisma).
DB_TRANSACTION_TIMEOUT_MS=10000
# A connection idle inside an open transaction (enforced by PostgreSQL). Must be LARGER than the
# transaction timeout. Order is enforced at startup: statement < transaction < idle.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# ---------- Test database (used by e2e tests) ----------
TEST_DATABASE_URL=postgresql://salesflow:change_me@localhost:5432/salesflow_test?schema=public

# ---------- Redis 7 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Host port published by the dev compose override (change if 6379 is taken locally).
REDIS_HOST_PORT=6379
# Empty = no authentication (local only). REQUIRED when NODE_ENV=production: the app will not start
# without it, which includes the prod-like `docker compose -f docker-compose.yml up`. Set a strong
# value anywhere Redis is reachable by more than you: the bundled compose then starts Redis with
# `--requirepass` and the api connects with it.
REDIS_PASSWORD=

# ---------- Queues (BullMQ) ----------
# Prefix of every queue key in Redis.
QUEUE_PREFIX=salesflow
# false = this process only enqueues jobs; true = it also runs the workers.
QUEUE_WORKERS_ENABLED=true
# Bull Board (queue inspection UI at /api/v1/queues). LOCAL DEVELOPMENT ONLY: no authentication.
# Leave false anywhere else. true together with NODE_ENV=production stops the app at startup.
QUEUE_BOARD_ENABLED=false
# e2e only: the Redis port the queue tests connect to (the compose Redis published on the host).
TEST_REDIS_PORT=6380

# ---------- Auth ----------
# HS256 signing key for access tokens, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random values (no signing secret); this is only their lifetime.
JWT_REFRESH_EXPIRES_IN=7d
# A refresh token rotated less than this many seconds ago is treated as a concurrent retry (409).
REFRESH_REUSE_GRACE_SECONDS=10

# ---------- Rate limiting ----------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Login (per IP + email) and other auth routes.
THROTTLE_AUTH_LIMIT=10
# Where the counters live: redis (default, shared by all instances) | memory (per process, development
# and tests only: REFUSED when NODE_ENV=production). With redis, if Redis cannot be consulted, auth routes
# answer 503 THROTTLE_UNAVAILABLE and other routes use a per-instance limiter. Needs Redis with
# maxmemory-policy noeviction.
THROTTLE_STORAGE=redis
# Express 'trust proxy': false | true | hop count (e.g. 1) | subnet list (e.g. loopback).
# Set it when the API runs behind a reverse proxy / load balancer, otherwise every client appears
# to have the proxy's IP and shares one rate-limit bucket. Keep false when exposed directly.
# With NODE_ENV=production and false, a warning is logged at startup as a reminder.
TRUST_PROXY=false

# ---------- Seed ----------
SEED_DEMO_DATA=false
SEED_ORG_NAME=Demo Organization
SEED_ORG_SLUG=demo
SEED_ADMIN_EMAIL=admin@example.com
# 10-128 chars (same rule as the API). The seed refuses this placeholder when NODE_ENV=production.
SEED_ADMIN_PASSWORD=change_me_strong_password

# ---------- org:create (operator CLI, not read by the API) ----------
# Optional. By default `pnpm org:create` generates the first admin password and prints it once.
# Set this only to choose it yourself (same 10-128 char rule; it is never printed).
# ORG_ADMIN_PASSWORD=
