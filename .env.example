# ---------- App ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true

# ---------- Database (PostgreSQL 16) ----------
POSTGRES_USER=salesflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=salesflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port published by the dev compose override (change if 5432 is taken locally).
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://salesflow:change_me@localhost:5432/salesflow?schema=public

# ---------- Test database (used by e2e tests) ----------
TEST_DATABASE_URL=postgresql://salesflow:change_me@localhost:5432/salesflow_test?schema=public

# ---------- Redis 7 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Host port published by the dev compose override (change if 6379 is taken locally).
REDIS_HOST_PORT=6379
REDIS_PASSWORD=

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Rate limiting ----------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ---------- Seed ----------
SEED_DEMO_DATA=false
SEED_ORG_NAME=Demo Organization
SEED_ORG_SLUG=demo
SEED_ADMIN_EMAIL=admin@example.com
# Min 12 chars. The seed refuses this placeholder when NODE_ENV=production.
SEED_ADMIN_PASSWORD=change_me_strong_password
